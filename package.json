{
  "name": "dsh-connect-trae",
  "displayName": "DSH Connect Trae",
  "description": "把本机登录的 Trae 模型接入 DeepSeek Harness：国内版与国际版双供应商并行，提供用量/积分概览与每日签到领取。",
  "version": "2.3.1",
  "author": "dingminhua",
  "copyright": "Copyright (c) 2026 LaoDing",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "trae",
    "model-provider",
    "usage",
    "credits"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "icons/dsh-connect-trae-128.png",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icons",
    "docs/assets/dsh-connect-trae-usage-card.png",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingminhua/dsh-connect-trae.git"
  },
  "homepage": "https://github.com/dingminhua/dsh-connect-trae#readme",
  "bugs": {
    "url": "https://github.com/dingminhua/dsh-connect-trae/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-atomic-write": "0.1.7-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "^0.85.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
